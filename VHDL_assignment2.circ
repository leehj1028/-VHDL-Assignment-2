  <vhdl appearance="logisim_evolution" name="logic4">library ieee;&#13;
use ieee.std_logic_1164.all;&#13;
&#13;
entity logic4 is&#13;
    port(&#13;
        a,b,c,d  :in  std_logic;&#13;
        out1,out2:out std_logic&#13;
    );&#13;
end entity logic4;&#13;
&#13;
architecture bhv of logic4 is&#13;
begin&#13;
    out1 &lt;= a and b and c and d;&#13;
    out2 &lt;= a or b or c or d;&#13;
end architecture bhv;&#13;
</vhdl>
  <vhdl appearance="logisim_evolution" name="mux8_1">library ieee;&#13;
use ieee.std_logic_1164.all;&#13;
&#13;
entity mux8_1 is&#13;
    port(&#13;
        a,b,c,d,e,f,g,h :in  std_logic;&#13;
        ch              :in  std_logic_vector(2 downto 0);&#13;
        data            :out std_logic&#13;
    );&#13;
end entity mux8_1;&#13;
&#13;
architecture bhv of mux8_1 is&#13;
begin&#13;
    process(a,b,c,d,e,f,g,h,ch)&#13;
    begin&#13;
        case ch is&#13;
            when "000" =&gt; data &lt;= a;&#13;
            when "001" =&gt; data &lt;= b;&#13;
            when "010" =&gt; data &lt;= c;&#13;
            when "011" =&gt; data &lt;= d;&#13;
            when "100" =&gt; data &lt;= e;&#13;
            when "101" =&gt; data &lt;= f;&#13;
            when "110" =&gt; data &lt;= g;&#13;
            when "111" =&gt; data &lt;= h;&#13;
            when others =&gt; data &lt;= '0';&#13;
        end case;&#13;
    end process;&#13;
end architecture bhv;&#13;
</vhdl>
  <vhdl appearance="logisim_evolution" name="seg_letter">library ieee;&#13;
use ieee.std_logic_1164.all;&#13;
&#13;
entity seg_letter is&#13;
    port(&#13;
        en      :in  std_logic;&#13;
        sel     :in  std_logic_vector(2 downto 0);&#13;
        display :out std_logic_vector(7 downto 0)  -- a b c d e f g dp&#13;
    );&#13;
end entity seg_letter;&#13;
&#13;
architecture bhv of seg_letter is&#13;
begin&#13;
    process(en, sel)&#13;
    begin&#13;
        if en = '0' then&#13;
            display &lt;= "ZZZZZZZZ";&#13;
        else&#13;
            case sel is&#13;
                when "000" =&gt; display &lt;= "11101110"; -- A&#13;
                when "001" =&gt; display &lt;= "00111110"; -- b&#13;
                when "010" =&gt; display &lt;= "10011100"; -- C&#13;
                when "011" =&gt; display &lt;= "01111010"; -- d&#13;
                when "100" =&gt; display &lt;= "10001110"; -- F&#13;
                when "101" =&gt; display &lt;= "10111100"; -- G&#13;
                when others =&gt; display &lt;= "00000000";&#13;
            end case;&#13;
        end if;&#13;
    end process;&#13;
end architecture bhv;&#13;
</vhdl>
